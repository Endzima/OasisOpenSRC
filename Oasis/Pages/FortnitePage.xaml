<Page x:Class="Pages.FortnitePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pages"
      mc:Ignorable="d" 
      Height="750" Width="1125">

    <Grid>
        <Image x:Name="FortniteBG" Stretch="Fill" Margin="0,0,0,0" Width="1125" Height="750"/>
        <DockPanel Background="Black" Opacity="0.5"/>
        <DockPanel Height="750" Width="320" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#131112" Opacity="0.7"/>
        <DockPanel Height="250" Width="1125" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#131112"/>
        
        <TextBlock Text="Fortnite v15.50" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="29" Foreground="White" FontWeight="SemiBold" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" Margin="-850,-550,0,0"/>
        <TextBlock VerticalAlignment="Center" Width="250" FontSize="14" Foreground="White" FontWeight="Medium" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" Margin="-800,-390,0,0">
            Season 5 of Chapter 2, also known
        <LineBreak/>
            as Season 15 of Battle Royale, started
        <LineBreak/>
            on December 2nd, 2020
        <LineBreak/>
            and ended on March 15th, 2021.
        </TextBlock>

        <Button Content="Launch" Width="225" Height="50" BorderBrush="Transparent" Margin="-835,-50,0,0" Foreground="#fafcfa" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium" Click="Launch_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Width="225" Height="50" CornerRadius="2,0,0,2" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#4b9e4f"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#4b9e4f" To="#56b05a"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#56b05a" To="#4b9e4f"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button Width="35" Height="50" BorderBrush="Transparent" Margin="-575,-50,0,0" Foreground="#fafcfa" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Width="35" Height="50" CornerRadius="0,2,2,0" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#488d4c"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#488d4c" To="#578e5a"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#578e5a" To="#488d4c"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button Name="ImportButton" Content="Import" Width="260" Height="50" Foreground="#474747" BorderBrush="Transparent" Margin="-800,-50,0,0" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium" Click="Import_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Width="260" Height="50" CornerRadius="2,0,0,2" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#bcbcbc"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#bcbcbc" To="#cecece"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#cecece" To="#bcbcbc"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <DockPanel Height="1" Background="#808080" Width="260" Margin="-800,35,0,0"/>
        <TextBlock Text="Our Socials:" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" Foreground="White" FontSize="13" Margin="-985,70,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Width="205" Height="30" Content="Is the gameserver online? Check here!" BorderBrush="Transparent" Margin="-855,-135,0,0" Foreground="#1780ff" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Width="205" Height="30" CornerRadius="0,2,2,0" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Foreground" Value="#1780ff"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Foreground.Color" Duration="00:00:00.15" From="#1780ff" To="#4f9fff"/>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="Transparent" To="Transparent"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Foreground.Color" Duration="00:00:00.15" From="#4f9fff" To="#1780ff"/>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="Transparent" To="Transparent"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Image x:Name="FortniteNews1" Width="350" Height="210" Margin="-380,500,0,0"/>
        <Image x:Name="FortniteNews2" Width="350" Height="210" Margin="380,500,0,0"/>
        <DockPanel HorizontalAlignment="Center" Background="Black" Opacity="0.6" Width="350" Height="85" Margin="-380,615,0,0"/>
        <DockPanel HorizontalAlignment="Center" Background="Black" Opacity="0.6" Width="350" Height="85" Margin="380,615,0,0"/>
        <TextBlock Name="DescText1" Margin="-400,645,0,0" Width="300" Height="30" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" Foreground="White" FontSize="12"/>
        <TextBlock Name="DescText2" Margin="365,645,0,0" Width="300" Height="30" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" Foreground="White" FontSize="12"/>

        <TextBlock Name="HeaderText1" Margin="-400,595,0,0" Width="300" Height="30" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" Foreground="White" FontSize="14" FontWeight="Bold"/>
        <TextBlock Name="HeaderText2" Margin="365,595,0,0" Width="300" Height="30" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" Foreground="White" FontSize="14" FontWeight="Bold"/>
        
        <Button Width="30" Height="20" Background="Transparent" Margin="-860,70,0,0" BorderBrush="Transparent" Cursor="Hand" Click="YouTube_Click" Grid.Row="1">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Image x:Name="NormalImage" Source="pack://application:,,,/src/images/ButtonIcons/YouTubeSocial.png" Visibility="Visible"/>
                        <Image x:Name="HoverImage" Source="pack://application:,,,/src/images/ButtonIcons/YouTubeSocialHover.png" Visibility="Collapsed"/>
                        <Image x:Name="PressedImage" Source="pack://application:,,,/src/images/ButtonIcons/YouTubeSocialClick.png" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NormalImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HoverImage" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverImage" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PressedImage" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="False">
                            <Setter TargetName="PressedImage" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Page>
