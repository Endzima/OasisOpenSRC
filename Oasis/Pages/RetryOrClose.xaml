<Page x:Class="Oasis.Pages.RetryOrClose"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1300"
      Title="RetryOrClose">

    <Grid>
        <TextBlock Text="You seem to be experiencing some network connectivity issues." FontSize="19" Foreground="#95c990" Margin="0,-160,0,0" HorizontalAlignment="Center" Height="30" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="3" Color="Black" Opacity="1" BlurRadius="3"/>
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock Text="The Oasis Launcher relies on an active internet connection to make the full range of Oasis Services" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium" Foreground="#c3c3c3" FontSize="16" HorizontalAlignment="Center" Height="25" Margin="0,-65,0,0">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="3" Color="Black" Opacity="1" BlurRadius="1"/>
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock Text="available. Please check your internet connection and retry, or close the launcher, and try again later." FontSize="16" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium" Foreground="#c3c3c3" HorizontalAlignment="Center" Height="25" Margin="0,-15,0,0">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="3" Color="Black" Opacity="1" BlurRadius="1"/>
            </TextBlock.Effect>
        </TextBlock>

        <Button Width="205" Height="30" Content="Report issue." BorderBrush="Transparent" Margin="0,680,0,0" Foreground="#474747" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium" Click="E7IsBent_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Width="205" Height="30" CornerRadius="0,2,2,0" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Foreground" Value="#474747"/>
                    <Setter Property="Background" Value="#bcbcbc"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Foreground.Color" Duration="00:00:00.15" From="#474747" To="#474747"/>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#bcbcbc" To="#cecece"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Foreground.Color" Duration="00:00:00.15" From="#474747" To="#474747"/>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#cecece" To="#bcbcbc"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Button Width="260" Height="50" BorderBrush="Transparent" Margin="-300,130,0,0" Content="RETRY" Foreground="#fafcfa" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium" Click="Retry_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Width="260" Height="50" CornerRadius="2" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#4b9e4f"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#4b9e4f" To="#56b05a"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#56b05a" To="#4b9e4f"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>


        <Button Width="260" Height="50" Background="Transparent" Content="CLOSE" Foreground="#fafcfa" BorderBrush="Transparent" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" FontWeight="Medium" Margin="300,130,0,0" Click="Close_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Width="260" Height="50" CornerRadius="2" Background="{TemplateBinding Background}" BorderBrush="#FF8EBA8A" BorderThickness="2">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="Transparent" To="#FF8EBA8A"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="Background.Color" Duration="00:00:00.15" From="#FF8EBA8A" To="Transparent"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</Page>
