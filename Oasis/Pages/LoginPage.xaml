<Page x:Class="Oasis.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      xmlns:local="clr-namespace:Oasis.Pages"
      mc:Ignorable="d" 
      Height="750" Width="1300">

    <Page.Resources>
        <Style x:Key="GreenButton2" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" BorderBrush="#4e4e4e" BorderThickness="3" Padding="10" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4e4e4e"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4e4e4e"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3e3e3e"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3e3e3e"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Gray"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="DarkGray"/>
                                <Setter Property="Foreground" Value="DarkGray"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <DockPanel HorizontalAlignment="Left" Width="500" Background="#0a0a0a"/>
        <TextBlock Text="Welcome to Stella!" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt" Foreground="White" Margin="-1000,-330,0,0" VerticalAlignment="Center" FontSize="25" HorizontalAlignment="Center"/>
        <TextBlock Text="We use Discord OAuth2 to authenticate accounts, sign in below!" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt" Foreground="White" FontWeight="Normal" Width="300" Margin="-910,275,0,0" FontSize="16" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        <Button Style="{StaticResource GreenButton2}" Width="280" Height="55" Margin="-935,100,0,0" HorizontalAlignment="Center" Click="SignIn_Click">
            <Grid>
                <TextBlock Text="SIGN IN WITH DISCORD" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt" Foreground="White" FontWeight="Heavy" Margin="0,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                <Image Source="pack://application:,,,/src/Content/New UI/discordicon.png" Height="20" Margin="160,0,0,0"/>
            </Grid>
        </Button>

        <TextBlock Text="Having trouble? Contact support!" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt" Foreground="White" FontWeight="Normal" Width="300" Margin="-910,375,0,0" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
        <TextBlock Text="When you click this link, Discord will open up in your browser so you can authorize." FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt" Foreground="White" FontWeight="Normal" Width="300" Margin="-910,515,0,0" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"/>
        <wv2:WebView2 Name="webView" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</Page>
