<Page x:Class="Oasis.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d" 
      Height="750" Width="1300">

    <Page.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="ButtonBorder" 
                Background="Transparent" 
                BorderBrush="Transparent" 
                BorderThickness="1" 
                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1f1d1d"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0a0a0a"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <DockPanel Background="#0d0d0d" Width="175" HorizontalAlignment="Left"/>
        <Button Width="175" Height="35" Style="{StaticResource MenuButtonStyle}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Margin="0,-400,0,0" MouseEnter="HomeButton_MouseEnter" MouseLeave="HomeButton_MouseLeave" Click="Home_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="HomeButtonIcon" Source="pack://application:,,,/src/images/ButtonIcons/Home.png" Width="20" Height="20" Opacity="0" VerticalAlignment="Center" Grid.Column="0" Margin="-100,0,0,0">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="HomeIconTransform"/>
                    </Image.RenderTransform>
                </Image>

                <TextBlock x:Name="HomeButtonText" Text="Home" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="-45,0,0,0" Grid.Column="1" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="HomeTextTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Button>
        <Button Width="175" Height="35" Style="{StaticResource MenuButtonStyle}" Padding="20,10,0,0" Margin="0,-300,0,0" HorizontalAlignment="Left" Click="FNPage_Click" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" Foreground="#7d7d7d" MouseEnter="FNBButton_MouseEnter" MouseLeave="FNBButton_MouseLeave">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="FNPButtonIcon" Source="pack://application:,,,/src/images/ButtonIcons/Fortnite.png" Width="20" Height="20" Opacity="0" VerticalAlignment="Center" Grid.Column="0" Margin="-100,0,0,0">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="FNPIconTransform"/>
                    </Image.RenderTransform>
                </Image>

                <TextBlock x:Name="FNPButtonText" Text="Fortnite" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="-45,0,0,0" Grid.Column="1" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="FNPTextTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Button>
        <Button Width="175" Height="35" Style="{StaticResource MenuButtonStyle}" Padding="20,10,0,0" Margin="0,-200,0,0" HorizontalAlignment="Left" Click="Store_Click" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL" Foreground="#7d7d7d" MouseEnter="StoreButton_MouseEnter" MouseLeave="StoreButton_MouseLeave">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image x:Name="StoreButtonIcon" Source="pack://application:,,,/src/images/ButtonIcons/Store.png" Width="20" Height="20" Opacity="0" VerticalAlignment="Center" Grid.Column="0" Margin="-100,0,0,0">
                    <Image.RenderTransform>
                        <TranslateTransform x:Name="StoreIconTransform"/>
                    </Image.RenderTransform>
                </Image>

                <TextBlock x:Name="StoreButtonText" Text="Shop" Foreground="#808080" FontSize="12" VerticalAlignment="Center" Margin="-45,0,0,0" Grid.Column="1" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="StoreTextTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Button>
        <Frame Name="MainFrame" Width="1125" HorizontalAlignment="Right"/>
        <Image Source="pack://application:,,,/src/images/yuh.png" Width="100" Height="65" Margin="-1130,-600,0,0"/>

        <Border CornerRadius="0" Background="#0a0a0a" Width="175" Height="90" Margin="0,660,0,0" HorizontalAlignment="Left"/>
        <DockPanel Background="#808080" Width="175" Height="1" Margin="0,635,0,0" HorizontalAlignment="Left"/>
        <TextBlock Text="Servers:" Margin="-1230,605,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>
        <TextBlock Name="StatusText" Margin="-1140,605,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>
        <TextBlock Name="UsernameText" Margin="-1090,710,0,0" Width="100" FontSize="12" VerticalAlignment="Center" Foreground="White" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>
        <Image Width="20" Height="20" Name="UserBadgeImage" Margin="-1170,675,0,0"/>
        <TextBlock Name="RoleText" Margin="-1075,675,0,0" Width="70" FontSize="11" VerticalAlignment="Center" Foreground="White" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>
        <Ellipse Width="35" Height="35" Margin="-1235,690,0,0">
            <Ellipse.Fill>
                <ImageBrush x:Name="AvatarImageBrush" />
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</Page>
