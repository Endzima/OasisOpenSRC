<Page x:Class="Pages.Home"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pages"
      mc:Ignorable="d" 
      Height="750" Width="1125">

    <Grid>
        <Border Name="NewsBorder1" CornerRadius="0" BorderThickness="0" BorderBrush="Transparent" Opacity="1" Width="1175" Height="435" Margin="0,0,0,0" VerticalAlignment="Top">
            <Border.Background>
                <ImageBrush x:Name="NewsImageFN1" Stretch="None"/>
            </Border.Background>
        </Border>
        <DockPanel Background="Black" Opacity="0.5" Height="435" VerticalAlignment="Top"/>
        <TextBlock Name="MainText" Foreground="White" Margin="-425,-435,0,0" Width="575" Height="50" FontWeight="Bold" FontSize="35" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>
        <TextBlock Name="DescText" Foreground="White" Margin="-450,-300,0,0" Width="550" Height="50" FontWeight="Medium" FontSize="20" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>

        <DockPanel Height="315" VerticalAlignment="Bottom" Background="#141213"/>
        <Image Source="pack://application:,,,/src/images/SkibidiToilet.png" Stretch="Fill" Margin="0,250,0,0" Height="500"/>
        <StackPanel Name="News2" Width="475" Height="255" Margin="-545,345,0,0" Background="Transparent">

            <Border x:Name="NewsBorder2" CornerRadius="7" BorderThickness="0" Margin="0,0,0,0" BorderBrush="Transparent" Opacity="1" Width="475" Height="255">
                <Border.Background>
                    <ImageBrush x:Name="NewsImageFN2" Stretch="Fill"/>
                </Border.Background>
            </Border>

            <Border CornerRadius="0,0,7,7" Height="100" Background="Black" Opacity="0.6" Margin="0,-100,0,0"/>
            
            <TextBlock x:Name="MainText2" Foreground="White" Margin="-30,-115,0,0" Width="385" Height="50" FontWeight="Bold" FontSize="18" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>
            <TextBlock x:Name="DescText2" Foreground="White" Margin="-40,-50,0,0" Width="375" Height="50" FontWeight="Medium" FontSize="13" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>
        </StackPanel>

        <StackPanel Name="News3" Margin="545,345,0,0" Width="475" Height="255" Background="Transparent">
            <Border Name="NewsBorder3" CornerRadius="7" BorderThickness="0" BorderBrush="Transparent" Opacity="1" Width="475" Height="255">
                <Border.Background>
                    <ImageBrush x:Name="NewsImageFN3" Stretch="Fill"/>
                </Border.Background>
            </Border>
            <Border CornerRadius="0,0,7,7" Height="100" Background="Black" Opacity="0.6" Margin="0,-100,0,0"/>
            <TextBlock Name="MainText3" Foreground="White" Margin="-30,-115,0,0" Width="385" Height="50" FontWeight="Bold" FontSize="18" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>
            <TextBlock Name="DescText3" Foreground="White" Margin="-20,-50,0,0" Width="395" Height="50" FontWeight="Medium" FontSize="14" FontFamily="pack://application:,,,/src/Fonts/#Bricolage Grotesque 14pt ExtraL"/>
        </StackPanel>
    </Grid>
</Page>
